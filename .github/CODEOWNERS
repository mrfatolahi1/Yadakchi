# ===========================================================================
# yadakchi — code ownership
#
# Ten services are built by ten different agents. These paths are the seams
# between them, and a human reviews every change to a seam.
#
# Replace @yadakchi-owner with the real GitHub handle or team.
# ===========================================================================

# Default: the repository owner sees anything not claimed below.
*                                   @yadakchi-owner

# The specs are the source of truth for fourteen documents and are distributed
# into every service folder. A spec change changes ten agents' instructions.
/docs/specs/                        @yadakchi-owner

# Shared infrastructure, the compose files, the Makefile and CI.
/platform/                          @yadakchi-owner
/docker-compose.yml                 @yadakchi-owner
/Makefile                           @yadakchi-owner
/pyproject.toml                     @yadakchi-owner
/.github/                           @yadakchi-owner

# Event schemas. A field rename here breaks a service nobody is looking at, so
# every published contract is human-reviewed — this is the whole point of the
# drift guard having teeth.
/services/*/contracts/published/**  @yadakchi-owner

# The distributed copies are generated by `make sync-specs`. Editing one by
# hand fails CI; changing them means changing docs/specs/.
/services/*/BRIEF.md                @yadakchi-owner
/services/*/SPEC.md                 @yadakchi-owner
