.vscode/
.DS_Store
*.swp

# --- Runtime scratch ----------------------------------------------------
*.log
tmp/
.docker-data/

# NOTE: services/*/BRIEF.md and services/*/SPEC.md are distributed spec
# copies produced by `make sync-specs`. They are COMMITTED on purpose so a
# fresh clone gives every agent its instructions with no setup step.
