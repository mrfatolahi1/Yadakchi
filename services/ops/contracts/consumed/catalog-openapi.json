{
  "openapi": "3.1.0",
  "info": {
    "title": "yadakchi catalog",
    "version": "1.0.0",
    "description": "Canonical products, sellers and price history. Read-only: everything this service learns arrives over Kafka, and everything it decides leaves over Kafka. `web` and `ops` are the only callers."
  },
  "paths": {
    "/v1/products/batch": {
      "post": {
        "operationId": "catalog_api_get_products_batch",
        "summary": "Many products by identity",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          }
        },
        "description": "Hydration fallback for search results. `search` renders from its own index built off products.changed; this exists for the moment the index is behind, not as a routine dependency.",
        "tags": [
          "products"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/v1/products/{slug}": {
      "get": {
        "operationId": "catalog_api_get_product",
        "summary": "Full product view by slug",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "schema": {
              "title": "Slug",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductOut"
                }
              }
            }
          },
          "301": {
            "description": "Moved Permanently",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedirectOut"
                }
              }
            }
          }
        },
        "description": "Resolves current slugs, historical slugs and retired products. An old slug or a retired product answers 301 with the target, because a URL that has ranked must never become a 404.",
        "tags": [
          "products"
        ]
      }
    },
    "/v1/products/by-uid/{product_uid}": {
      "get": {
        "operationId": "catalog_api_get_product_by_uid",
        "summary": "Full product view by identity",
        "parameters": [
          {
            "in": "path",
            "name": "product_uid",
            "schema": {
              "title": "Product Uid",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductOut"
                }
              }
            }
          },
          "301": {
            "description": "Moved Permanently",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedirectOut"
                }
              }
            }
          }
        },
        "tags": [
          "products"
        ]
      }
    },
    "/v1/sellers/{seller_key}": {
      "get": {
        "operationId": "catalog_api_get_seller",
        "summary": "Seller profile and trust breakdown",
        "parameters": [
          {
            "in": "path",
            "name": "seller_key",
            "schema": {
              "title": "Seller Key",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerOut"
                }
              }
            }
          }
        },
        "tags": [
          "sellers"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "catalog_api_health",
        "summary": "Liveness and DB reachability",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        },
        "tags": [
          "ops"
        ]
      }
    }
  },
