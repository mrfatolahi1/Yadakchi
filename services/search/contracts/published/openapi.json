{
  "openapi": "3.1.0",
  "info": {
    "title": "yadakchi search",
    "version": "1.0.0",
    "description": ""
  },
  "paths": {
    "/v1/search": {
      "get": {
        "operationId": "search_api_search",
        "summary": "Search",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "title": "Q",
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "vehicle_slug",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Vehicle Slug"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "brand",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Brand"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "part_type",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Part Type"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "authenticity",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authenticity"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "min_price_toman",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Price Toman"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "max_price_toman",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Max Price Toman"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "has_image",
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Has Image"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "title": "Page",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "default": 20,
              "title": "Page Size",
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "search"
        ]
      }
    },
    "/v1/suggest": {
      "get": {
        "operationId": "search_api_suggest",
        "summary": "Suggest",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "title": "Q",
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 10,
              "title": "Limit",
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "search"
        ]
      }
    },
