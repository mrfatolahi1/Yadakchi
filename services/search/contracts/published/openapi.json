      "post": {
        "operationId": "search_api_click",
        "summary": "Click",
        "parameters": [],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedResponse"
                }
              }
            }
          }
        },
        "tags": [
          "events"
