# ===========================================================================
# yadakchi — platform environment
#
#   cp platform/.env.example platform/.env      # then change every password
#
# This file is committed; platform/.env is git-ignored. No secrets in code —
# every credential in the system enters through here. The values below are
# development placeholders and are safe only on a laptop.
#
# Service agents: your service reads the variables under your own heading.
# You never receive credentials for another service's database, and there is
# nothing to gain by trying — Postgres refuses the connection.
# ===========================================================================

COMPOSE_PROJECT_NAME=yadakchi
TZ=UTC                       # storage is UTC everywhere; Tehran time is display-only

# --- PostgreSQL ------------------------------------------------------------
# One server, eight databases, eight users. See platform/postgres/init.sql.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser

CRAWLER_DB_PASSWORD=change-me-crawler
ENRICHER_DB_PASSWORD=change-me-enricher
FITMENT_DB_PASSWORD=change-me-fitment
MATCHER_DB_PASSWORD=change-me-matcher
CATALOG_DB_PASSWORD=change-me-catalog
SEARCH_DB_PASSWORD=change-me-search
BILLING_DB_PASSWORD=change-me-billing
OPS_DB_PASSWORD=change-me-ops

# Ready-made DSNs. Each service gets exactly one of these as DATABASE_URL.
CRAWLER_DATABASE_URL=postgres://crawler:change-me-crawler@postgres:5432/yadakchi_crawler
ENRICHER_DATABASE_URL=postgres://enricher:change-me-enricher@postgres:5432/yadakchi_enricher
FITMENT_DATABASE_URL=postgres://fitment:change-me-fitment@postgres:5432/yadakchi_fitment
MATCHER_DATABASE_URL=postgres://matcher:change-me-matcher@postgres:5432/yadakchi_matcher
CATALOG_DATABASE_URL=postgres://catalog:change-me-catalog@postgres:5432/yadakchi_catalog
SEARCH_DATABASE_URL=postgres://search:change-me-search@postgres:5432/yadakchi_search
BILLING_DATABASE_URL=postgres://billing:change-me-billing@postgres:5432/yadakchi_billing
OPS_DATABASE_URL=postgres://ops:change-me-ops@postgres:5432/yadakchi_ops

# --- Kafka -----------------------------------------------------------------
# Single broker, KRaft mode. Production hardening = three brokers, RF=3.
KAFKA_CLUSTER_ID=s_Mzx3_CRxOV7_zN3r2PMw     # KRaft cluster id (base64 uuid); changing it invalidates the log
KAFKA_BOOTSTRAP_SERVERS=kafka:9092          # from inside the yadakchi network
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:19092 # from your laptop
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Consumer groups are per service and per purpose: "<service>.<purpose>",
# e.g. matcher.offers-enriched. Never share a group across services.

# --- Redis -----------------------------------------------------------------
# Cache and locks only. NEVER an event bus — that is Kafka's job.
# One logical database per service so a FLUSHDB cannot cross a boundary:
#   0 crawler   1 enricher   2 fitment   3 matcher   4 catalog
#   5 search    6 billing    7 ops       8 ai        9 web
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
CRAWLER_REDIS_URL=redis://:change-me-redis@redis:6379/0
ENRICHER_REDIS_URL=redis://:change-me-redis@redis:6379/1
FITMENT_REDIS_URL=redis://:change-me-redis@redis:6379/2
MATCHER_REDIS_URL=redis://:change-me-redis@redis:6379/3
CATALOG_REDIS_URL=redis://:change-me-redis@redis:6379/4
SEARCH_REDIS_URL=redis://:change-me-redis@redis:6379/5
BILLING_REDIS_URL=redis://:change-me-redis@redis:6379/6
OPS_REDIS_URL=redis://:change-me-redis@redis:6379/7
AI_REDIS_URL=redis://:change-me-redis@redis:6379/8
WEB_REDIS_URL=redis://:change-me-redis@redis:6379/9

# --- MinIO (raw archive; crawler only) -------------------------------------
MINIO_ROOT_USER=yadakchi-root
MINIO_ROOT_PASSWORD=change-me-minio-root
MINIO_ENDPOINT=http://minio:9000
RAW_ARCHIVE_BUCKET=raw-archive
CRAWLER_S3_ACCESS_KEY=crawler
CRAWLER_S3_SECRET_KEY=change-me-crawler-s3
# No other service has credentials here. Downstream services rebuild from
# Kafka, never from object storage.

# --- Typesense (search only) -----------------------------------------------
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=change-me-typesense-admin
TYPESENSE_SEARCH_ONLY_API_KEY=change-me-typesense-search-only  # safe for the browser

# --- Observability ---------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
SENTRY_DSN=                 # empty disables Sentry
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=INFO
LOG_FORMAT=json             # structured JSON to stdout, never print()

# --- Service-to-service HTTP ----------------------------------------------
# The only synchronous calls allowed by the brief. Everything else is Kafka.
AI_BASE_URL=http://ai:8000
CATALOG_BASE_URL=http://catalog:8000
SEARCH_BASE_URL=http://search:8000
BILLING_BASE_URL=http://billing:8000
INTERNAL_HTTP_TIMEOUT_SECONDS=10

# --- Host ports (published for humans) -------------------------------------
POSTGRES_HOST_PORT=15432
KAFKA_HOST_PORT=19092
KAFKA_UI_PORT=8080
REDIS_HOST_PORT=16379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
TYPESENSE_HOST_PORT=8108
WEB_PORT=3000
OPS_PORT=8009
